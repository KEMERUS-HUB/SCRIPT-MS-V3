local TIMING = { water=22, sugar=1, gelatin=47, empty=2, rest=3 }
local TOOL_NAMES = {
    water   = {"water","air","water bucket","bucket of water","air bucket","water container","air minum"},
    sugar   = {"sugar block bag","sugar block","gula","sugar bag","sugar sack","sugar cube","gula block"},
    gelatin = {"gelatin","gelatin bag","gelatin block","gelatin sack","gelatin cube","agar"},
    empty   = {"emptybag","empty bag","empty back","emptyback","kosong","empty sack","kantong kosong"},
}
local cookRunning=false; local cookLoopThread=nil
local function cookFindTool(nameList)
    local char=LocalPlayer.Character; local bp=LocalPlayer:FindFirstChild("Backpack")
    local containers={}
    if char then table.insert(containers,char) end
    if bp then table.insert(containers,bp) end
    for _,container in ipairs(containers) do
        for _,obj in ipairs(container:GetChildren()) do
            if obj:IsA("Tool") then
                local lower=string.lower(obj.Name)
                for _,target in ipairs(nameList) do if lower:find(target,1,true) then return obj,(container==char) end end
            end
        end
    end
    return nil,false
end
local function cookEquip(nameList)
    local tool,isEquipped=cookFindTool(nameList)
    if not tool then return false end
    if isEquipped then return true end
    local ok=pcall(function() tool.Parent=LocalPlayer.Character end)
    if ok then task.wait(0.4) end
    _,isEquipped=cookFindTool(nameList)
    return isEquipped
end
local function cookPatchPrompt(pr) pcall(function() pr.HoldDuration=0; pr.RequiresLineOfSight=false end) end
local function cookFirePrompt(pr)
    if not pr or not pr.Parent then return false end
    cookPatchPrompt(pr)
    if fireproximityprompt then local ok=pcall(fireproximityprompt,pr); if ok then task.wait(0.2); return true end end
    local ok2=pcall(function() game:GetService("ProximityPromptService"):TriggerPrompt(pr) end)
    if ok2 then task.wait(0.2); return true end
    pcall(function() pr:InputHoldBegin(); task.wait(math.max(pr.HoldDuration,0)+0.1); pr:InputHoldEnd() end)
    task.wait(0.2); return true
end
local function cookFindPrompt(radius)
    radius=radius or 30; local char=LocalPlayer.Character; if not char then return nil end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end
    local best,bestDist=nil,radius
    for _,obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local part=obj.Parent; local pos=nil
            if part and part:IsA("BasePart") then pos=part.Position end
            if part and part:IsA("Attachment") then pos=part.WorldPosition end
            if pos then local dist=(pos-hrp.Position).Magnitude; if dist<bestDist then bestDist=dist; best=obj end end
        end
    end
    return best
end
local function cookStep(stepName,nameList,waitTime,sc)
    if not cookRunning then return false end
    if sc then sc("Equip "..stepName.."...") end
    if not cookEquip(nameList) then if sc then sc("⚠ "..stepName.." tidak ditemukan, skip") end; return true end
    task.wait(0.3); if not cookRunning then return false end
    if sc then sc("Trigger E ("..stepName..")...") end
    local pr=cookFindPrompt(30)
    if pr then cookFirePrompt(pr) else task.wait(0.5); pr=cookFindPrompt(30); if pr then cookFirePrompt(pr) end end
    if sc then sc("⏳ "..stepName.." ("..waitTime.."s)...") end
    local t0=tick(); while cookRunning and (tick()-t0)<waitTime do task.wait(0.5) end
    return cookRunning
end
local function cookCycle(sc)
    if not cookRunning then return false end
    if sc then sc("Equip Water...") end
    if not cookEquip(TOOL_NAMES.water) then if sc then sc("❌ Water tidak ditemukan — retry 3s...") end; task.wait(3); return false end
    task.wait(0.3); if not cookRunning then return false end
    local pr=cookFindPrompt(30)
    if not pr then if sc then sc("❌ Prompt mesin tidak ditemukan — retry 3s...") end; task.wait(3); return false end
    if sc then sc("⏳ Menuang air ("..TIMING.water.."s)...") end
    cookFirePrompt(pr)
    local t0=tick(); while cookRunning and (tick()-t0)<TIMING.water do task.wait(0.5) end
    if not cookRunning then return false end
    if not cookStep("Sugar",TOOL_NAMES.sugar,TIMING.sugar,sc) then return false end
    if not cookStep("Gelatin",TOOL_NAMES.gelatin,TIMING.gelatin,sc) then return false end
    if not cookStep("Empty Bag",TOOL_NAMES.empty,TIMING.empty,sc) then return false end
    if not cookRunning then return false end
    if sc then sc("💤 Jeda ("..TIMING.rest.."s)...") end
    task.wait(TIMING.rest); return true
end
local function StartCook(sc)
    if cookRunning then return end
    cookRunning=true
    cookLoopThread=task.spawn(function()
        local cycle=0
        while cookRunning do
            cycle=cycle+1
            if sc then sc("🍳 Cycle #"..cycle) end
            local ok=cookCycle(sc)
            if not ok and cookRunning then task.wait(2) end
        end
        if sc then sc("⏹ Berhenti") end
    end)
end
local function StopCook()
    cookRunning=false
    if cookLoopThread then task.cancel(cookLoopThread); cookLoopThread=nil end
end

