local AF_BIND = { bindType="none", mouseBtn=nil, keyCode=nil }

local function AutoF_HasToolEquipped()
    local char=LocalPlayer.Character; if not char then return false end
    for _,obj in ipairs(char:GetChildren()) do if obj:IsA("Tool") then return true end end
    return false
end
local function AutoF_PressF()
    pcall(function()
        local VIM=game:GetService("VirtualInputManager")
        VIM:SendKeyEvent(true,Enum.KeyCode.F,false,game)
        task.wait(0.05)
        VIM:SendKeyEvent(false,Enum.KeyCode.F,false,game)
    end)
end
local function AutoF_Start()
    if autoFConn then autoFConn:Disconnect() end
    autoFConn=RunService.Heartbeat:Connect(function()
        if not autoFEnabled then return end
        if AutoF_HasToolEquipped() then AutoF_PressF() end
        task.wait(0.15)
    end)
end
local function AutoF_Stop()
    autoFEnabled=false
    if autoFConn then autoFConn:Disconnect(); autoFConn=nil end
end
local function AutoF_SyncUI()
    if _afStatusLbl then
        _afStatusLbl.Text       = autoFEnabled and "Status: ON  —  Mendeteksi tool di tangan" or "Status: OFF"
        _afStatusLbl.TextColor3 = autoFEnabled and COLORS.Success or COLORS.TextDim
    end
end
local function AutoF_Toggle()
    autoFEnabled=not autoFEnabled
    if autoFEnabled then AutoF_Start() else AutoF_Stop() end
    AutoF_SyncUI()
end
local function AutoF_MatchesBind(inp)
    if isBindingKey then return false end
    if AF_BIND.bindType=="keyboard" then
        return inp.UserInputType==Enum.UserInputType.Keyboard and inp.KeyCode==AF_BIND.keyCode
    elseif AF_BIND.bindType=="mouse" then
        return inp.UserInputType==AF_BIND.mouseBtn
    end
    return false
end
UserInputService.InputBegan:Connect(function(inp,gpe)
    if gpe then return end
    if AutoF_MatchesBind(inp) then AutoF_Toggle() end
end)

