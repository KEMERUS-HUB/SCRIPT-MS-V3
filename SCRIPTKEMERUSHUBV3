local SWITCH_R = 3

local function MakeBoxSwitch(parent, xOff, yOff, initVal, onChange)
    local track = Instance.new("Frame")
    track.Size             = UDim2.new(0, 44, 0, 24)
    track.Position         = UDim2.new(1, xOff, 0, yOff)
    track.BackgroundColor3 = initVal and COLORS.Accent or COLORS.Border
    track.BorderSizePixel  = 0
    track.Parent           = parent
    CreateUICorner(SWITCH_R, track)

    local trackLbl = Instance.new("TextLabel")
    trackLbl.Size               = UDim2.new(1, 0, 1, 0)
    trackLbl.BackgroundTransparency = 1
    trackLbl.Text               = initVal and "ON" or "OFF"
    trackLbl.Font               = Enum.Font.GothamBold
    trackLbl.TextSize           = 8
    trackLbl.TextColor3         = Color3.fromRGB(255,255,255)
    trackLbl.TextXAlignment     = initVal and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
    trackLbl.Parent             = track
    local lpad = Instance.new("UIPadding")
    lpad.PaddingLeft  = UDim.new(0,5)
    lpad.PaddingRight = UDim.new(0,5)
    lpad.Parent       = trackLbl

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 18, 0, 18)
    knob.Position         = initVal and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)
    knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.BorderSizePixel  = 0
    knob.ZIndex           = 2
    knob.Parent           = track
    CreateUICorner(SWITCH_R, knob)

    local hit = Instance.new("TextButton")
    hit.Size               = UDim2.new(1,0,1,0)
    hit.BackgroundTransparency = 1
    hit.Text               = ""
    hit.AutoButtonColor    = false
    hit.ZIndex             = 3
    hit.Parent             = track

    local state = initVal

    local function SetState(v, silent)
        state = v
        TweenObject(track, {BackgroundColor3 = v and COLORS.Accent or COLORS.Border}, 0.15)
        TweenObject(knob,  {Position = v and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)}, 0.15)
        trackLbl.Text           = v and "ON" or "OFF"
        trackLbl.TextXAlignment = v and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
        if not silent and onChange then onChange(v) end
    end

    hit.MouseButton1Click:Connect(function() SetState(not state) end)
    return hit, SetState, function() return state end
end

